# ── Production example ── copy to .env on the server and fill real values
NODE_ENV=production
PORT=4002

# Wave OAuth app credentials
CLIENT_ID=
CLIENT_SECRET=
# Must exactly match the redirect URI registered in Wave developer portal
REDIRECT_URL=https://api.your-domain.com/callback

# Frontend URL (CORS + redirect after login)
CLIENT_ORIGIN=https://your-domain.com

# Long random string, required in production
SESSION_SECRET=

# "lax" when frontend and backend share the same site,
# "none" when they are on different domains (needs HTTPS)
COOKIE_SAMESITE=lax
